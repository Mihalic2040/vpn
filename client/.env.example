# WireGuard client peer values. Never commit real private keys.
WG_PRIVATE_KEY=replace-with-the-railway-peer-private-key
WG_ADDRESS=10.8.0.3/32
WG_MTU=1280
WG_SERVER_PUBLIC_KEY=replace-with-the-vps-server-public-key
WG_PRESHARED_KEY=replace-with-the-client-peer-preshared-key
WG_ENDPOINT=vpn.example.com:51820
WG_ALLOWED_IPS=10.8.0.0/24
WG_PERSISTENT_KEEPALIVE=25

# TCP routing table. Keep this JSON on one line in dotenv files.
# vpn_to_local: 10.8.0.3:8887 -> api.railway.internal:8000
# local_to_vpn: gateway.railway.internal:8893 -> 10.8.0.2:5566
ROUTES_JSON=[{"direction":"vpn_to_local","listen_port":8887,"target_host":"api.railway.internal","target_port":8000},{"direction":"local_to_vpn","listen_port":8893,"target_host":"10.8.0.2","target_port":5566}]
